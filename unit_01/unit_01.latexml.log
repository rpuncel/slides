\footnotesizeGiven a probability space $(\Omega, S, P)$, For all events $A, B \inS$ :
\begin{align*}
\tag{\textit{Monotonicity}}
& \text{If } A \subseteqB\text{, then }P(A) \leqP(B) \\
\tag{\textit{Subtraction}}
& \text{If } A \subseteqB\text{, then the probability
assigned to }B \\ & \text{\hspace{1em} but not }A,
\text{written }P(B\textbackslashA) = P(B) - P(A) \\
\tag{\textit{Probability Bounds}}
& 0 \leqP(A) \leq1 \\
\tag{\textit{Compliments}}
& P(A^{C}) = 1 - P(A) \\
\end{align*}
