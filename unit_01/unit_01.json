                [
                  "t",
                  "\n  ",
                  {
                    "frametitle": "\\frametitle{Partition Rule 2}"
                  },
                  "\n  Given a set ",
                  {
                    "$": [
                      {
                        "begin": "$"
                      },
                      [
                        "A"
                      ],
                      {
                        "end": "$"
                      }
                    ]
                  },
                  " and another set ",
                  {
                    "$": [
                      {
                        "begin": "$"
                      },
                      [
                        "B"
                      ],
                      {
                        "end": "$"
                      }
                    ]
                  },
                  ", a partition of ",
                  {
                    "$": [
                      {
                        "begin": "$"
                      },
                      [
                        "A ",
                        {
                          "cup": "\\cup"
                        },
                        " B"
                      ],
                      {
                        "end": "$"
                      }
                    ]
                  },
                  " is...\n  ",
                  {
                    "center": "\\center"
                  },
                  " ",
                  {
                    "includegraphics": "\\includegraphics[width=0.5\\textwidth]{./figures/ab}"
                  },
                  "\n  ",
                  "\n  ",
                  {
                    "note": "\\note[item]{Here's a slightly harder problem, what if we want to partition the entire union?}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{This time, we can break it apart into 3 pieces.  Same as last time, plus also B minus A.}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{Let's quickly prove it...}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{Let's just apply the previous relationship twice!}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{$A \\cup B   = (A \\cap B) \\cup (A \\setminus B) \\cup (A \\cap B) \\cup (B \\setminus A) $}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{Guess what, A intersect B is in there twice.  if you take a union of a set with itself, you get the same set, so we can just remove one of them and we're done.}"
                  },
