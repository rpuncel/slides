                [
                  "\n",
                  {
                    "note": "\\note[item]{Now let's carefully read the law of total probability.}"
                  },
                  "\n",
                  {
                    "note": "\\note[item]{The probability of B is a sum, if you look inside the sum, what we do is we intersect B with some $A_i$, which is part of the partition, then take the probability.}"
                  },
                  "\n",
                  {
                    "note": "\\note[item]{To finish the law, we can then apply the multiplication rule.  we write each of these joint probabilities as a product.  First, we take the probability we're inside $A_i$, then multiply it by the conditional probability that we're also in B.}"
                  },
                  "\n",
                  {
                    "note": "\\note[item]{That's the law of total probability.  It can be quite useful, if you can think of a good partition.}"
                  },
                  "\n  ",
                  {
                    "frametitle": "\\frametitle{Total Probability, Part I}"
                  },
                  "\n  ",
                  {
                    "block": [
                      {
                        "begin": "\\begin{block}{The Law of Total Probability}"
                      },
                      [
                        "The Law of Total Probability",
                        "\n    If",
                        {
                          "$": [
                            {
                              "begin": "$"
                            },
                            [
                              "\\ ",
                              "A_",
                              {
                                "BraceGroup": [
                                  {
                                    "begin": "{"
                                  },
                                  [
                                    "1"
                                  ],
                                  {
                                    "end": "}"
                                  }
                                ]
                              },
                              ", A_",
                              {
                                "BraceGroup": [
                                  {
                                    "begin": "{"
                                  },
                                  [
                                    "2"
                                  ],
                                  {
                                    "end": "}"
                                  }
                                ]
                              },
                              ", ",
                              {
                                "dots": "\\dots"
                              },
                              ", A_",
                              {
                                "BraceGroup": [
                                  {
                                    "begin": "{"
                                  },
                                  [
                                    "n"
                                  ],
                                  {
                                    "end": "}"
                                  }
                                ]
                              }
                            ],
                            {
                              "end": "$"
                            }
                          ]
                        },
                        " is a partition of ",
                        {
                          "$": [
                            {
                              "begin": "$"
                            },
                            [
                              {
                                "Omega": "\\Omega"
                              }
                            ],
                            {
                              "end": "$"
                            }
                          ]
                        },
                        ", and\n    if ",
                        {
                          "$": [
                            {
                              "begin": "$"
                            },
                            [
                              "B ",
                              {
                                "in": "\\in"
                              },
                              " ",
                              {
                                "Omega": "\\Omega"
                              }
                            ],
                            {
                              "end": "$"
                            }
                          ]
                        },
                        ", then\n    ",
                        {
                          "displaymath": [
                            {
                              "begin": "\\["
                            },
                            [
                              "\n      P(B) = ",
                              {
                                "sum": "\\sum"
                              },
                              "_",
                              {
                                "BraceGroup": [
                                  {
                                    "begin": "{"
                                  },
                                  [
                                    "i"
                                  ],
                                  {
                                    "end": "}"
                                  }
                                ]
                              },
                              " P(B ",
                              {
                                "cap": "\\cap"
                              },
                              " A_",
                              {
                                "BraceGroup": [
                                  {
                                    "begin": "{"
                                  },
                                  [
                                    "i"
                                  ],
                                  {
                                    "end": "}"
                                  }
                                ]
                              },
                              ")\n    "
                            ],
                            {
                              "end": "\\]"
                            }
                          ]
                        },
                        "\n    If there is a positive probability for each partition ",
                        {
                          "$": [
                            {
                              "begin": "$"
                            },
                            [
                              "A_",
                              {
                                "BraceGroup": [
                                  {
                                    "begin": "{"
                                  },
                                  [
                                    "i"
                                  ],
                                  {
                                    "end": "}"
                                  }
                                ]
                              }
                            ],
                            {
                              "end": "$"
                            }
                          ]
                        },
                        ",\n    then by the ",
                        {
                          "textit": "\\textit{Multiplicative Law of Probability}"
                        },
                        "\n    ",
                        {
                          "displaymath": [
                            {
                              "begin": "\\["
                            },
                            [
                              "\n      P(B) = ",
                              {
                                "sum": "\\sum"
                              },
                              "_",
                              {
                                "BraceGroup": [
                                  {
                                    "begin": "{"
                                  },
                                  [
                                    "i"
                                  ],
                                  {
                                    "end": "}"
                                  }
                                ]
                              },
                              " P(B | A_",
                              {
                                "BraceGroup": [
                                  {
                                    "begin": "{"
                                  },
                                  [
                                    "i"
                                  ],
                                  {
                                    "end": "}"
                                  }
                                ]
                              },
                              ")P(A_",
                              {
                                "BraceGroup": [
                                  {
                                    "begin": "{"
                                  },
                                  [
                                    "i"
                                  ],
                                  {
                                    "end": "}"
                                  }
                                ]
                              },
                              ")\n    "
                            ],
                            {
                              "end": "\\]"
                            }
                          ]
                        },
                        "\n  "
                      ],
                      {
                        "end": "\\end{block}"
                      }
                    ]
