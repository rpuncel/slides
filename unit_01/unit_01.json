            },
            "\n",
            "\n",
            "\n",
            {
              "section": "\\section{Bayes' Rule}"
            },
            "\n",
            "\n",
            {
              "frame": [
                {
                  "begin": "\\begin{frame}"
                },
                [
                  "\n  ",
                  {
                    "frametitle": "\\frametitle{Conditional Inverses}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{We know about conditional probability.  Let's say we have two events X and Y.  Are these two conditional probabilities the same?}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{In fact, the answer is usually no.  here's an example to convince you. <read>}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{There is an easy way to get from one of these probabilities to the other.  it's the famous theorem known as Bayes' Rule.}"
                  },
                  "\n ",
                  {
                    "center": [
                      {
                        "begin": "\\begin{center}"
                      },
                      [
                        " Does ",
                        {
                          "$": [
                            {
                              "begin": "$"
                            },
                            [
                              "P(X|Y) = P(Y|X)"
                            ],
                            {
                              "end": "$"
                            }
                          ]
                        },
                        "? "
                      ],
                      {
                        "end": "\\end{center}"
                      }
                    ]
                  },
                  "\n  ",
                  "\n  ",
                  {
                    "pause": "\\pause"
                  },
                  "\n  Example: \n",
                  {
                    "itemize": [
                      {
                        "begin": "\\begin{itemize}"
                      },
                      [
                        "\n",
                        {
                          "item": "\\item"
                        },
                        {
                          "item": "\\item"
                        }
                      ],
                      {
                        "end": "\\end{itemize}"
                      }
                    ]
                  },
                  "\n",
                  "\n"
                ],
                {
                  "end": "\\end{frame}"
                }
              ]
            },
            "\n",
            "\n",
            "\n",
            {
              "frame": [
                {
                  "begin": "\\begin{frame}"
                },
                [
                  "\n  ",
                  {
                    "frametitle": "\\frametitle{Deriving Bayes' Rule}"
                  },
                  "\n  ",
                  "\n  ",
                  {
                    "note": "\\note[item]{Deriving Bayes' Rule is easy.  We start with the probability of X and Y.  Then wewrite the multiplication rule two ways.}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{ $P(Y)P(X|Y)=$.  and $=P(X)P(Y|X)$.}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{Divide: $P(X|Y) = \\frac{P(Y|X)P(X)}{P(Y) } $}"
                  },
                  "\n ",
                  {
                    "note": "\\note[item]{That's Bayes's Rule!  It's easy to derive if you ever forget it.}"
                  },
                  "\n  ",
                  "\n ",
                  {
                    "vspace": "\\vspace{-2cm}"
                  },
                  " ",
                  {
                    "$$": [
                      {
                        "begin": "$$"
                      },
                      [
                        "P(X ",
                        {
                          "cap": "\\cap"
                        },
                        " Y)"
                      ],
                      {
                        "end": "$$"
                      }
                    ]
                  },
                  "\n",
                  "\n"
                ],
                {
                  "end": "\\end{frame}"
                }
              ]
            },
            "\n",
            "\n",
            "\n",
            {
              "frame": [
                {
                  "begin": "\\begin{frame}[t]"
                },
                [
                  "t",
                  "\n  ",
                  {
                    "frametitle": "\\frametitle{Bayes' Rule Example}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{Why is Baye's rule important?  It can tell us how to adjust probabilities of hypotheses in response to evidence.}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{Let's work through a problem together.  This is a very classic example for Bayes' Rule.}"
                  },
                  "\n  ",
                  "\n",
                  {
                    "itemize": [
                      {
                        "begin": "\\begin{itemize}"
                      },
                      [
                        "\n",
                        {
                          "item": "\\item"
                        },
                        {
                          "item": "\\item"
                        },
                        {
                          "item": "\\item"
                        }
                      ],
                      {
                        "end": "\\end{itemize}"
                      }
                    ]
                  },
                  "\n",
                  "\n",
                  "\nGiven that you get a positive test, what is the probability that you have the disease?\n\n",
                  {
                    "note": "\\note[item]{You can see that this sounds quite scary, right?  the test is correct 99\\% of the time.}"
                  },
                  "\n",
                  "\n",
                  {
                    "itemize": [
                      {
                        "begin": "\\begin{itemize}"
                      },
                      [
                        "\n",
                        {
                          "item": "\\item"
                        },
                        {
                          "item": "\\item"
                        }
                      ],
                      {
                        "end": "\\end{itemize}"
                      }
                    ]
                  },
                  "\n",
                  "\n",
                  {
                    "note": "\\note[item]{Write down what we know: $P(D) = .0002$,$ P(D^C) = .9998$, $P(T|D)=1$, $P(T|D^C) = .01$}"
                  },
                  "\n"
                ],
                {
                  "end": "\\end{frame}"
                }
              ]
            },
            "\n",
            "\n",
            "\n",
            "\n",
            {
              "frame": [
                {
                  "begin": "\\begin{frame}[t]"
                },
                [
                  "t",
                  "\n  ",
                  {
                    "frametitle": "\\frametitle{Bayes' Rule Example Cont.}"
                  },
                  "\n",
                  "\nWe know:  ",
                  {
                    "$": [
                      {
                        "begin": "$"
                      },
                      [
                        "P(D) = .0002,  P(D^C) = .9998"
                      ],
                      {
                        "end": "$"
                      }
                    ]
                  },
                  "\\\\",
                  "\n ",
                  {
                    "$": [
                      {
                        "begin": "$"
                      },
                      [
                        {
                          "qquad": "\\qquad"
                        },
                        " ",
                        {
                          "qquad": "\\qquad"
                        },
                        " ",
                        "\\ ",
                        "\\ ",
                        " P(T|D)=1, P(T|D^C) = .01"
                      ],
                      {
                        "end": "$"
                      }
                    ]
                  },
                  "\n",
                  "\n",
                  "\nWe want: ",
                  {
                    "$": [
                      {
                        "begin": "$"
                      },
                      [
                        "P(D|T)"
                      ],
                      {
                        "end": "$"
                      }
                    ]
                  },
                  "\n",
                  "\n",
                  {
                    "note": "\\note[item]{$P(D|T) = \\frac{P(T|D)P(D)}{P(T)}$ }"
                  },
                  "\n",
                  {
                    "note": "\\note[item]{Still missing $P(T)$.  Can use law of total probability, using D for partition.}"
                  },
                  "\n",
                  {
                    "note": "\\note[item]{$P(T) = P(D)P(T|D) + P(D^C)P(T|D^C)$  }"
                  },
                  "\n",
                  {
                    "note": "\\note[item]{$P(D|T) = \\frac{P(T|D)P(D)}{P(T)} =  \\frac{P(T|D)P(D)}{ P(D)P(T|D) + P(D^C)P(T|D^C) = .0196}$}"
                  },
                  "\n",
                  {
                    "note": "\\note[item]{Even though the test is 99\\% accurate, there is still less than a 2\\% chance you have the disease.}"
                  },
                  "\n"
                ],
                {
                  "end": "\\end{frame}"
                }
              ]
            },
            "\n",
            "\n",
            "\n",
            {
              "frame": [
                {
                  "begin": "\\begin{frame}"
                },
                [
                  "\n  ",
                  {
                    "frametitle": "\\frametitle{Bayesian Statistics}"
                  },
                  "\n  ",
                  "\n  ",
                  {
                    "note": "\\note[item]{Bayes' Rule is the foundation of an entire school of stats.}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{Let me try to compress an entire school into 60 seconds.}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{In bayesian stats, we may be interested in some hypothesis.  Let H be the event that it's true.}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{To a mainstream statistician, that doesn't make any sense, a hypothesis is true or false.}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{To a bayesian, probability is used to represent your personal subjective belief.  before you see the data, you give the hypothesis a prior probability, P(H)}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{Then you see data, D.  you can use bayes rule to update your probability to $P(H|D)$.  this is your posterior.  }"
                  },
                  "\n  ",
                  "\n  Let H be the event a hypothesis is true.\n  ",
                  {
                    "itemize": [
                      {
                        "begin": "\\begin{itemize}"
                      },
                      [
                        "\n",
                        {
                          "item": "\\item"
                        }
                      ],
                      {
                        "end": "\\end{itemize}"
                      }
                    ]
                  },
                  "\n",
                  "\n  Let D be the data we collect\n  ",
                  {
                    "itemize": [
                      {
                        "begin": "\\begin{itemize}"
                      },
                      [
                        "\n",
                        {
                          "item": "\\item"
                        }
                      ],
                      {
                        "end": "\\end{itemize}"
                      }
                    ]
                  },
                  "\n",
                  "\n",
                  {
                    "note": "\\note[item]{There's your 60 second crash course on Bayesian stats.}"
                  },
                  "\n"
                ],
                {
                  "end": "\\end{frame}"
                }
              ]
            },
            "\n",
            "\n",
            "\n",
            "\n",
            "\n",
            "\n",
