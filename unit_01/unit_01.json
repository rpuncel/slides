                  " ",
                  "\\\\",
                  " \n  ",
                  {
                    "footnotesize": "\\footnotesize"
                  },
                  " Image: www.flickr.com/photos/billward/ (CC BY 2.0)\n  ",
                  {
                    "note": "\\note[item]{This week, we're starting with the foundation.  probability theory}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{This is really the nuts and bolts, how do the pieces of\n    statistical models fit together.}"
                  },
                  " \n  ",
                  {
                    "note": "\\note[item]{A strong understanding of probability will be useful to\n    you through this course and through your career as a data\n    scientist.}"
                  },
                  " \n"
                ],
                {
                  "end": "\\end{frame}"
                }
              ]
