                  "begin": "\\begin{frame}[t]"
                },
                [
                  "t",
                  "\n  ",
                  {
                    "frametitle": "\\frametitle{Partition Rule 1}"
                  },
                  "\n  Given a set ",
                  {
                    "$": [
                      {
                        "begin": "$"
                      },
                      [
                        "A"
                      ],
                      {
                        "end": "$"
                      }
                    ]
                  },
                  " and another set ",
                  {
                    "$": [
                      {
                        "begin": "$"
                      },
                      [
                        "B"
                      ],
                      {
                        "end": "$"
                      }
                    ]
                  },
                  ", a partition of ",
                  {
                    "$": [
                      {
                        "begin": "$"
                      },
                      [
                        "A"
                      ],
                      {
                        "end": "$"
                      }
                    ]
                  },
                  " is...\n  ",
                  {
                    "center": "\\center"
                  },
                  " ",
                  {
                    "includegraphics": "\\includegraphics[width=0.5\\textwidth]{./figures/ab}"
                  },
                  "\n  ",
                  "\n  ",
                  {
                    "note": "\\note[item]{Can you see the partition?  Here's one piece, and here's the other.}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{This one is A minus B, this one is the intersection.  Let's quickly prove it...}"
                  },
                  "\n  ",
                  {
                    "note": "\\note[item]{$A  = A \\cap (B \\cup B^C) = (A \\cap B) \\cup (A \\cap B^C)  = (A \\cap B) \\cup (A \\setminus B)$}"
                  },
                  "\n"
                ],
                {
                  "end": "\\end{frame}"
                }
