                            },
                            [
                              "0.6",
                              {
                                "textwidth": "\\textwidth"
                              },
                              "\n      \"Essentially, the theory of probability is nothing but good common\n      sense reduced to mathematics. It provides an exact appreciation of\n      what sound minds feel with a kind of instinct, frequently without\n      being able to account for it.\u201d",
                              "\\\\",
                              " \n      - Pierre-Simon Laplace\n    "
                            ],
                            {
                              "end": "\\end{column}"
                            }
