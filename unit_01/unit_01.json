            "\n",
            {
              "frame": [
                {
                  "begin": "\\begin{frame}"
                },
                [
                  "\n  ",
                  {
                    "frametitle": "\\frametitle{Probablity is A System of Reasoning}"
                  },
                  "\n",
                  "\n  ",
                  {
                    "columns": [
                      {
                        "begin": "\\begin{columns}"
                      },
                      [
                        "\n    ",
                        {
