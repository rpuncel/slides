            "\n",
            "\n",
            "\n",
            {
              "section": "\\section{Reading: Independence}"
            },
            "\n",
            "\n",
            {
              "frame": [
                {
                  "begin": "\\begin{frame}"
                },
                [
                  "\n  ",
                  {
                    "frametitle": "\\frametitle{Reading: Independence}"
                  },
                  "\n  Read section 1.1.4, Independence of Events\n"
                ],
                {
                  "end": "\\end{frame}"
                }
              ]
            },
            "\n",
            "\n",
            "\n",
            {
              "section": "\\section{Independence}"
            },
            "\n",
            "\n",
            {
              "frame": [
                {
                  "begin": "\\begin{frame}"
                },
                [
                  "\n  ",
                  {
                    "frametitle": "\\frametitle{Independence}"
                  },
                  "\n",
                  "\n",
                  {
                    "note": "\\note[item]{Let's take a look at the formal definition of independence.  Notice that we use the elegant product equation.  This version is a bit more universal.  If event have probability zero, there may not be a good way to define conditional probability. }"
                  },
                  "\n  ",
                  {
                    "block": [
                      {
                        "begin": "\\begin{block}{Independence of events}"
                      },
                      [
                        "Independence of events",
                        "\n    Events ",
                        {
                          "$": [
                            {
                              "begin": "$"
                            },
                            [
                              "A, B ",
                              {
                                "in": "\\in"
                              },
                              " S"
                            ],
                            {
                              "end": "$"
                            }
                          ]
                        },
                        " are ",
                        {
                          "textit": "\\textit{independent}"
                        },
                        " if ",
                        {
                          "$": [
                            {
                              "begin": "$"
                            },
                            [
                              "P(A ",
                              {
                                "cap": "\\cap"
                              },
                              " B) =\n    P(A)P(B)"
                            ],
                            {
