                              },
                              "\n      ",
                              {
                                "$": [
                                  {
                                    "begin": "$"
                                  },
                                  [
                                    "A = ",
                                    "\\{",
                                    "1,2",
                                    "\\}",
                                    ", B = ",
                                    "\\{",
                                    "2,4,6",
                                    "\\}"
                                  ],
                                  {
                                    "end": "$"
                                  }
